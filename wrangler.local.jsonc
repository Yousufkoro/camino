{
  "name": "camino-your-direction",
  "main": "worker/standalone.mjs",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "SOURCE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 15,
        "period": 60
      }
    }
  ]
}
